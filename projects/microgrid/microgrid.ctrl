        {
            "code_block": "mem.phase_cycles += timestep * (in.f - in.f_nominal);\nmem.phase_cycles -= floor(mem.phase_cycles);  // remove full cycles\n\nout.V = in.V_mag * complex(cos(2.0f * pi * mem.phase_cycles), sin(2.0f * pi * mem.phase_cycles));\n\n//daher was here.\n",
            "description": "Voltage source phasor simulation",
            "frequency": 1000,
            "inputs": [
