    "functions": [
        {
            "code_block": "float quad_error = imag(in.ref * conj(out.osc));\n// kp_LPF path\nmem.slow_term += clamp(quad_error * in.kp_slow, -in.delta_f, in.delta_f) - mem.slow_term * in.kp_slow_alpha;\n// proportional path\nfloat fast_term = clamp(quad_error * in.kp, -in.delta_f, in.delta_f);\nfloat pll_freq = in.freq_nominal + mem.slow_term + fast_term;\nout.frequency += (pll_freq - out.frequency) * in.freq_lpf_alpha;\n// oscillator\nmem.phase_cycles += in.timestep * (out.frequency - in.freq_nominal);\nmem.phase_cycles -= floor(mem.phase_cycles);  // remove full cycles\nout.osc = complex(cos(2.0f * pi * mem.phase_cycles), sin(2.0f * pi * mem.phase_cycles));\n",
            "description": "Phase locked loop for a phasor simulation",
            "inputs": [
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "ref",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
