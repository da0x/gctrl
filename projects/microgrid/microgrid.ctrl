                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "3f6b27af-eaa8-4db0-9380-1589334d53d6",
                    "value": "(0e+0f, 0e+0f)"
                },
                {
