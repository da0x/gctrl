            "uuid": "2295f269-4b2e-439c-bd84-ab7711729a41"
        },
        {
            "code_block": "// load PLL inputs and run it\nPLL_sim.in.ref = in.V;\nPLL_sim.in.freq_nominal = in.freq_nominal;\t// move to init() callback\nPLL_sim();\n\nstd::complex<float> S = in.V * conj(in.I) * (in.reversed_CT ? -1.0f : 1.0f);\n\n// update outputs - outputs are also \"states\"\nout.freq += (PLL_sim.out.frequency - out.freq) * in.lpf_alpha;\n\nout.P += (real(S) - out.P) * in.lpf_alpha;\nout.Q += (imag(S) - out.Q) * in.lpf_alpha;\nout.V_mag += (abs(in.V) - out.V_mag) * in.lpf_alpha;\nout.I_mag += (abs(in.I) - out.I_mag) * in.lpf_alpha;\n",
            "description": "Meter for a phasor simulation",
            "frequency": 1000,
            "functions": [
                {
                    "description": "Phase locked loop for a phasor simulation",
                    "direction": "ltr",
                    "name": "PLL_sim",
                    "prototype_uuid": "5686c1aa-1b8f-4b4f-8d10-2d0fb0ee95c6",
                    "uuid": "34ca7965-5528-4f90-b9a1-09b84a483655"
                }
            ],
            "inputs": [
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "V",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "b480268f-5779-4afc-b043-b1f6c711864b",
                    "value": "(0e+0f, 0e+0f)"
                },
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "I",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "c5125d72-6e1b-4f33-9f6c-6c42cdd05a1e",
                    "value": "(0e+0f, 0e+0f)"
                },
                {
                    "description": "Boolean",
                    "direction": "ltr",
                    "name": "reversed_CT",
                    "prototype_uuid": "9786c237-804e-4109-b3d8-e8f9bc43f682",
                    "uuid": "11edded8-9cac-4e58-b35e-41b0d33992d7",
