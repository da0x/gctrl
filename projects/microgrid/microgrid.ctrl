                    "direction": "ltr",
                    "name": "Y",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "a3c31718-0daa-4973-b69a-437c380d2a8e",
                    "value": "(0e+0f, 0e+0f)"
                },
                {
                    "description": "Boolean",
                    "direction": "ltr",
                    "name": "disconnect",
                    "prototype_uuid": "9786c237-804e-4109-b3d8-e8f9bc43f682",
                    "uuid": "70dd99f2-dafb-4d23-a98a-31b940c59152",
                    "value": "false"
                }
            ],
            "name": "passive_load_sim",
            "namespace": "element",
            "outputs": [
