        {
            "code_block": "complex rotation_vector(1.0f, mem.rotation_angle);\ncomplex V_new = in.Z * (in.Iin-in.Iout);\n\nfloat new_angle = -imag(conj(V_new) * out.Vout);\nnew_angle = clamp(new_angle, -in.rotation_limit, in.rotation_limit);\nmem.rotation_angle += (new_angle - mem.rotation_angle) * in.rotation_alpha;\n\nout.Vout = (V_new - out.Vout * rotation_vector) * in.rotation_alpha + (out.Vout*rotation_vector);\n",
            "description": "Bus voltage solver (phasor)",
            "frequency": 1000,
            "inputs": [
                {
                    "description": "Real Number",
                    "direction": "ltr",
                    "name": "rotation_limit",
                    "prototype_uuid": "12270a17-e1f4-4473-91c3-f698d303e093",
                    "uuid": "e98ff505-fbd1-4d6a-b50b-9aee6a2ab268",
                    "value": "0e+0f"
                },
