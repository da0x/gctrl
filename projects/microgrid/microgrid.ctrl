    "elements": [
        {
            "code_block": "// Add your code here\n",
            "description": "Voltage and frequency checks to qualify the \"grid\"",
            "frequency": 1000,
            "name": "ac_checks",
            "namespace": "element",
            "uuid": "7ec4637e-519b-46da-af8a-8317deafcf39"
        },
        {
            "code_block": "out.I = (in.Vup - in.Vdown) * in.Y * (in.breaker_open ? 0.0f : 1.0f);\n",
            "description": "Calculate phasor current flowing in impedance between two voltages",
            "frequency": 1000,
            "inputs": [
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "Vup",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "35278706-f6f2-4698-a883-9d7f853bf5ee",
                    "value": "(0e+0f, 0e+0f)"
                },
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "Vdown",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "4a4d38fe-761c-42cf-a34c-c3fd1948e3f7",
                    "value": "(0e+0f, 0e+0f)"
                },
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "Y",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "53f74ef3-36ec-475b-98a9-a2675d727ecf",
                    "value": "(0e+0f, 0e+0f)"
                },
                {
                    "description": "Boolean",
                    "direction": "ltr",
                    "name": "breaker_open",
                    "prototype_uuid": "9786c237-804e-4109-b3d8-e8f9bc43f682",
                    "uuid": "72b41c24-149e-43ae-a8a8-f7c9162c7bfa",
                    "value": "false"
                }
            ],
            "name": "calculate_current",
            "namespace": "element",
            "outputs": [
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "I",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "cea10aa0-91ae-4e2d-92a7-e2c710d56066",
                    "value": "(0e+0f, 0e+0f)"
                }
            ],
            "uuid": "f3844667-deb2-473b-aafe-2235dc0d054f"
        },
        {
            "code_block": "out.V = in.V_pu * in.V_nominal;\nout.I_pu = in.I / fmax(in.I_nominal, 1e-3);\n\n",
            "description": "Voltage PU->SI and current SI->PU",
            "frequency": 1000,
            "inputs": [
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "V_pu",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "77d8df2b-4952-4d4b-a52d-5d333e7f2374",
                    "value": "(0e+0f, 0e+0f)"
                },
                {
                    "description": "Real Number",
                    "direction": "ltr",
                    "name": "V_nominal",
                    "prototype_uuid": "12270a17-e1f4-4473-91c3-f698d303e093",
                    "uuid": "4c6ffb41-0c95-4828-bfc5-9375bab8f1a7",
                    "value": "0e+0f"
                },
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "I",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "ec7ab0f3-b61c-402b-ae71-83cb0bb9a464",
                    "value": "(0e+0f, 0e+0f)"
                },
                {
                    "description": "Real Number",
                    "direction": "ltr",
                    "name": "I_nominal",
                    "prototype_uuid": "12270a17-e1f4-4473-91c3-f698d303e093",
                    "uuid": "ba3ddbed-b04e-414d-b021-5ae388d34d13",
                    "value": "0e+0f"
                }
            ],
            "name": "electrical_phase_socket_scaling",
            "namespace": "element",
            "outputs": [
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "V",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "1e9e0027-3ff7-477f-83a8-1718c0ebe0b6",
                    "value": "(0e+0f, 0e+0f)"
                },
                {
                    "description": "Complex Number",
