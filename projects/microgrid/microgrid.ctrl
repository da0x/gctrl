        {
            "code_block": "out.I = (in.disconnect ? 0.0f : 1.0f) * (in.V * in.Y);\n\n",
            "description": "Load simulator for a passive load: I = Y * V",
            "frequency": 1000,
            "inputs": [
                {
                    "description": "Complex Number",
                    "direction": "ltr",
                    "name": "V",
                    "prototype_uuid": "3a87cbc2-b213-4e5e-8c5a-720dadb19f91",
                    "uuid": "7c4369a8-f3f6-40b5-a9ab-7446e20788fe",
                    "value": "(0e+0f, 0e+0f)"
                },
